@startuml

' Packages
package "swarm.infra" {
  class DroneConfig <<final>> {
    {static} +AGENT_CAPACITY_LITERS: int
    {static} +BASE_POSITION: Position
  }

  class UDPHelper {
    +send(message: String, destPort: int): void
    +receive(): String
  }

  class ZoneManager {
    +getZone(id: int): Zone
    +getZoneCenter(id: int): Position
  }
}

package "swarm.main" {
  class SimulatorGUI {
    +{static} instance: SimulatorGUI
    -zoneManager: ZoneManager
    +SimulatorGUI()
    +updateDroneAgent(droneId: int, agentLiters: int): void
    +markDroneFault(droneId: int, fault: FaultType): void
    +updateDroneMovement(...): void
    +updateDroneInfo(...): void
    +setZoneOnFire(zoneId: int, severity: String): void
    +clearZone(zoneId: int): void
    +log(msg: String): void
  }

  class MapCanvas <<inner>>
  class DroneRenderState <<inner>>

  class DroneMarker <<inner>> {
    -agentLabel: JLabel
    +updateAgent(liters: int): void
  }

  class Launcher {
    +main(args: String[]): void
  }

  class MetricsCollector {
    +{static} instance: MetricsCollector
    -missionRecords: Map
    -droneRecords: Map
    -droneToMission: Map
    -firstFireDetectedMs: long
    -lastFireExtinguishedMs: long
    +recordFireDetected(...): int
    +recordDroneDispatched(...)
    +recordDroneArrived(id: int): void
    +recordFireExtinguished(id: int): void
    +recordMissionComplete(id: int): void
    +recordDroneStateChange(...)
    +avgResponseTimeMs(): double
    +avgExtinguishTimeMs(): double
    +totalIncidentToAllClearMs(): long
    +avgDroneFlightTimeMs(): double
    +buildSummary(): String
    +printSummary(): void
  }

  class MissionRecord <<inner>>
  class DroneTimeRecord <<inner>>
}

package "swarm.messages" {
  enum FaultType {
    NONE
    DRONE_STUCK
    NOZZLE_JAMMED
    PACKET_LOSS
  }

  enum DroneState {
    IDLE
    EN_ROUTE
    ARRIVED
    DROPPING_AGENT
    RETURNING
    REFILLING
    SOFT_FAULT
    HARD_FAULT
  }

  enum EventType {
    FIRE_DETECTED
  }

  enum Severity {
    LOW
    MODERATE
    HIGH
    +litersRequired(): int
  }

  class FireEvent <<record>> {
    +zoneId: int
    +severity: Severity
    +fault: FaultType
  }
}

package "swarm.model" {
  class Position <<record>>
  class Zone <<record>>
}

package "swarm.subsystems" {
  class DroneSubsystem {
    -udp: UDPHelper
    -droneId: int
    -hardFaulted: boolean
    +run(): void
    -executeMission(...): void
  }

  class FireIncidentSubsystem {
    -udp: UDPHelper
    +run(): void
  }

  class Scheduler {
    -udp: UDPHelper
    -metrics: MetricsCollector
    -missionQueue: Queue<FireEvent>
    +run(): void
    -tryDispatch(): void
    -handleMessage(msg: String): void
  }
}

' Dependencies & Relationships
Launcher --> UDPHelper
Launcher --> ZoneManager
Launcher --> FireIncidentSubsystem
Launcher --> Scheduler
Launcher --> DroneSubsystem
Launcher --> SimulatorGUI

' Inner Classes
SimulatorGUI +-- MapCanvas
SimulatorGUI +-- DroneRenderState
SimulatorGUI +-- DroneMarker
MetricsCollector +-- MissionRecord
MetricsCollector +-- DroneTimeRecord

' Subsystems use UDP for communication
FireIncidentSubsystem --> UDPHelper
Scheduler --> UDPHelper
DroneSubsystem --> UDPHelper

' Iteration 5 Metrics Dependencies
Scheduler --> MetricsCollector
SimulatorGUI ..> MetricsCollector

' Domain Models
DroneSubsystem --> ZoneManager
DroneSubsystem ..> DroneConfig
DroneSubsystem ..> Position
Scheduler ..> Position

ZoneManager o-- "0..*" Zone
Zone o-- "2" Position

FireEvent --> EventType
FireEvent --> Severity
FireEvent --> FaultType

SimulatorGUI --> DroneState
SimulatorGUI --> FaultType
SimulatorGUI --> ZoneManager

@enduml