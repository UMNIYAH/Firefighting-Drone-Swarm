@startuml
skinparam classAttributeIconSize 0
hide circle

' Packages
package "swarm.infra" {
  class DroneConfig <<final>> {
    {static} +AGENT_CAPACITY_LITERS: int
    {static} +BASE_POSITION: Position
    {static} +travelTimeMillis(distanceMeters: double): long
    {static} +dropTimeMillis(litersRequired: int): long
    {static} +doorOpenCloseMillis(): long
  }

  class UDPHelper {
    -socket: DatagramSocket
    -port: int
    +UDPHelper(port: int)
    +send(message: String, destPort: int): void
    +receive(): String
  }

  class ZoneManager {
    -zones: Map<Integer, Zone>
    +ZoneManager(zoneFilePath: String)
    +getZone(id: int): Zone
    +getZoneCenter(id: int): Position
  }
}

package "swarm.main" {
  class SimulatorGUI {
    +{static} instance: SimulatorGUI
    -zoneManager: ZoneManager
    +SimulatorGUI()
    +log(msg: String): void
    +updateDroneMovement(...): void
    +updateDroneInfo(...): void
    +markDroneFault(droneId: int, fault: FaultType): void
    +setZoneOnFire(zoneId: int, severity: String): void
    +clearZone(zoneId: int): void
  }

  class MapCanvas <<inner>> {
    +paintComponent(g: Graphics): void
  }

  class DroneRenderState <<inner>> {
    +state: DroneState
    +fault: FaultType
    +tick(): void
  }

  class DroneMarker <<inner>> {
    +update(stateText: String, color: Color): void
  }

  class Launcher {
    +main(args: String[]): void
  }
}

package "swarm.messages" {
  enum FaultType {
    NONE
    DRONE_STUCK
    NOZZLE_JAMMED
    PACKET_LOSS
    +isHardFault(): boolean
  }

  enum DroneState {
    IDLE
    EN_ROUTE
    ARRIVED
    DROPPING_AGENT
    RETURNING
    REFILLING
    SOFT_FAULT
    HARD_FAULT
  }

  enum EventType {
    FIRE_DETECTED
  }

  class FireEvent <<record>> {
    +timestampMillis: long
    +zoneId: int
    +type: EventType
    +severity: Severity
    +fault: FaultType
    +timestamp(): Instant
  }

  enum Severity {
    LOW
    MODERATE
    HIGH
    +litersRequired(): int
  }
}

package "swarm.model" {
  class Position <<record>> {
    +x: double
    +y: double
    +distanceTo(other: Position): double
  }
  class Zone <<record>> {
    +id: int
    +start: Position
    +end: Position
    +center(): Position
  }
}

package "swarm.subsystems" {
  class DroneSubsystem {
    -udp: UDPHelper
    -droneId: int
    -zoneManager: ZoneManager
    -hardFaulted: boolean
    +run(): void
    -processMissions(): void
    -executeMission(...): void
    -reportStatus(...): void
  }

  class FireIncidentSubsystem {
    -udp: UDPHelper
    -inputFileName: String
    +run(): void
    -readIncidents(): void
  }

  class Scheduler {
    -udp: UDPHelper
    -missionQueue: Queue<FireEvent>
    -dispatchTimes: Map<Integer, Long>
    -offlineDrones: Set<Integer>
    +run(): void
    -handleMessage(msg: String): void
    -tryDispatch(): void
    -startWatchdogTimer(): void
  }
}

' Dependencies & Relationships
Launcher --> UDPHelper
Launcher --> ZoneManager
Launcher --> FireIncidentSubsystem
Launcher --> Scheduler
Launcher --> DroneSubsystem
Launcher --> SimulatorGUI

' Inner Classes
SimulatorGUI +-- MapCanvas
SimulatorGUI +-- DroneRenderState
SimulatorGUI +-- DroneMarker

' Subsystems use UDP for communication
FireIncidentSubsystem --> UDPHelper
Scheduler --> UDPHelper
DroneSubsystem --> UDPHelper

' Domain Models
DroneSubsystem --> ZoneManager
DroneSubsystem ..> DroneConfig
DroneSubsystem ..> Position
Scheduler ..> Position

ZoneManager o-- "0..*" Zone
Zone o-- "2" Position

FireEvent --> EventType
FireEvent --> Severity
FireEvent --> FaultType

SimulatorGUI --> DroneState
SimulatorGUI --> FaultType
SimulatorGUI --> ZoneManager

@enduml