@startuml
title DroneSubsystem State Machine

[*] --> IDLE

state IDLE {
}
IDLE : reportStatus(IDLE, null)
IDLE --> EN_ROUTE : take(DroneCommand)

EN_ROUTE : reportStatus(EN_ROUTE, zoneId)
EN_ROUTE : sleep(travelTimeMillis(distance))
EN_ROUTE --> DROPPING_AGENT : arrive at zone center

DROPPING_AGENT : reportStatus(DROPPING_AGENT, zoneId)
DROPPING_AGENT : sleep(dropTimeMillis(litersRequired) + doorOpenCloseMillis())
DROPPING_AGENT : currentAgent -= litersRequired
DROPPING_AGENT --> RETURNING : finished drop

RETURNING : reportStatus(RETURNING, null)
RETURNING : sleep(travelTimeMillis(distanceToBase))
RETURNING --> REFILLING : reached base

REFILLING : currentPosition = BASE_POSITION
REFILLING : currentAgent = AGENT_CAPACITY_LITERS
REFILLING : reportStatus(REFILLING, null)
REFILLING : sleep(1000)
REFILLING --> IDLE : ready for next mission

EN_ROUTE --> IDLE : zoneCenter == null (skip mission)

@enduml