@startuml
title DroneSubsystem State Machine (Iteration 4 - Fault Tolerance)

[*] --> IDLE

state IDLE {
}
IDLE : Wait for UDP CMD
IDLE : reportStatus(IDLE, NONE)
IDLE --> EN_ROUTE : receive(CMD:zoneId:severity:faultType)

state EN_ROUTE {
}
EN_ROUTE : reportStatus(EN_ROUTE, NONE)
EN_ROUTE : sleep(travelTimeMillis(distance))
EN_ROUTE --> DROPPING_AGENT : arrive at zone center
EN_ROUTE --> SOFT_FAULT : if fault == DRONE_STUCK
EN_ROUTE --> IDLE : if zoneCenter == null (invalid)

state SOFT_FAULT {
}
SOFT_FAULT : reportStatus(SOFT_FAULT, DRONE_STUCK)
SOFT_FAULT : sleep(3000ms)
SOFT_FAULT : currentPosition = BASE_POSITION
SOFT_FAULT --> IDLE : self-recover (mission aborted)

state DROPPING_AGENT {
}
DROPPING_AGENT : reportStatus(DROPPING_AGENT, NONE) [May drop packet]
DROPPING_AGENT : sleep(dropTimeMillis(litersRequired) + doorOpenCloseMillis)
DROPPING_AGENT : currentAgent -= litersRequired
DROPPING_AGENT --> RETURNING : finished drop
DROPPING_AGENT --> HARD_FAULT : if fault == NOZZLE_JAMMED

state HARD_FAULT {
}
HARD_FAULT : hardFaulted = true
HARD_FAULT : reportStatus(HARD_FAULT, NOZZLE_JAMMED)
HARD_FAULT --> [*] : permanently offline

state RETURNING {
}
RETURNING : reportStatus(RETURNING, NONE) [May drop packet]
RETURNING : sleep(travelTimeMillis(distanceToBase))
RETURNING --> REFILLING : reached base

state REFILLING {
}
REFILLING : currentPosition = BASE_POSITION
REFILLING : currentAgent = AGENT_CAPACITY_LITERS
REFILLING : reportStatus(REFILLING, NONE)
REFILLING : sleep(200ms)
REFILLING --> IDLE : ready for next mission

@enduml